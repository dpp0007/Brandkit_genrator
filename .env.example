# Copy to .env.local for local development, or set these in your host's environment settings.

# --- Required ---
# MongoDB Atlas connection string. Include the database name before the "?", e.g. ...mongodb.net/brandmeld?retryWrites=true&w=majority
MONGODB_URI=
# Encrypts stored API keys (AES-256-GCM). Required in production. Generate with: openssl rand -hex 32
# Keep it: if it changes, saved keys can't be decrypted and users must re-enter them.
# (In local development, if unset, a random one is generated in ./.data/secret.key.)
BRANDMELD_SECRET=

# --- Optional ---
# Database name, only if it is not in the connection string.
MONGODB_DB=
# Gemini model used for voice/messaging interpretation.
BRANDMELD_MODEL=gemini-3.5-flash-lite

# --- Development only (leave unset in production) ---
# Point the app at the local stand-ins started by `npm run mock`.
# TINYFISH_FETCH_URL=http://localhost:4010
# TINYFISH_SEARCH_URL=http://localhost:4010
# TINYFISH_BROWSER_URL=http://localhost:4011
# GEMINI_API_BASE=http://localhost:4010/v1beta
