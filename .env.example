# --- Production ---
# Where SQLite (brandmeld.db) and the generated encryption key live. Point at a persistent disk.
BRANDMELD_DATA_DIR=
# Encrypts stored API keys (AES-256-GCM). Set it and keep it. If unset, a random one is generated in the data dir.
BRANDMELD_SECRET=
# Gemini model used for voice/messaging interpretation.
BRANDMELD_MODEL=gemini-3.5-flash-lite

# --- Development only (leave unset in production) ---
# Point the app at the local stand-ins started by `npm run mock`.
TINYFISH_FETCH_URL=http://localhost:4010
TINYFISH_SEARCH_URL=http://localhost:4010
TINYFISH_BROWSER_URL=http://localhost:4011
GEMINI_API_BASE=http://localhost:4010/v1beta
